---
import Layout from '../layouts/Layout.astro';
import ClientClerkSignIn from '../components/ClientClerkSignIn.jsx';

const clerkPublishableKey = process.env.CLERK_PUBLISHABLE_KEY ?? import.meta.env.PUBLIC_CLERK_PUBLISHABLE_KEY ?? '';
---

<Layout title="Agency OS | Secure Login">
  <main class="flex min-h-screen w-full items-center justify-center px-4 py-16">
    <div class="relative w-full max-w-md">
      <div class="absolute inset-0 rounded-full bg-indigo-500/20 blur-[80px] pointer-events-none"></div>
      <ClientClerkSignIn publishableKey={clerkPublishableKey} client:idle />
    </div>
  </main>
</Layout>
