---
// src/components/Services.astro
const services = [
  {
    title: "High-Performance Static Builds",
    description: "Sub-second load times engineered with modern static architecture. Zero bloated plugins, ultra-secure, and optimized for maximum mobile conversion.",
    tag: "Astro & Tailwind",
    icon: "⚡"
  },
  {
    title: "Local SEO & Structured Data",
    description: "Google-compliant JSON-LD LocalBusiness schema and metadata injection designed to outrank local competitors and drive organic leads.",
    tag: "Search Optimization",
    icon: "📍"
  },
  {
    title: "Full-Stack Custom Web Apps",
    description: "Client portals, interactive booking engines, internal dashboards, and database integrations tailored to your exact business workflow.",
    tag: "Supabase & Next.js",
    icon: "🛠️"
  },
  {
    title: "Modern UI/UX Redesigns",
    description: "Transform outdated WordPress, Wix, or legacy websites into clean, modern experiences that establish immediate trust with customers.",
    tag: "Brand Elevation",
    icon: "✨"
  }
];
---

<section id="services" class="w-full max-w-7xl mx-auto px-6 md:px-12 py-24 scroll-mt-24 border-t border-slate-800/40">
  <div class="max-w-3xl mb-16">
    <div class="text-xs uppercase tracking-widest text-indigo-400 font-bold mb-3">Our Capabilities</div>
    <h2 class="text-3xl md:text-5xl font-extrabold tracking-tight text-white mb-6">
      Engineered for speed, built to convert.
    </h2>
    <p class="text-lg text-slate-400 leading-relaxed">
      Every build is engineered from scratch for performance, accessibility, and clear business outcomes—without bloated agency retainers.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    {services.map((service) => (
      <div class="bg-slate-900/40 border border-slate-800/80 rounded-2xl p-8 hover:border-indigo-500/40 transition-all duration-300 hover:shadow-[0_0_30px_rgba(79,70,229,0.1)] group">
        <div class="flex items-center justify-between mb-6">
          <span class="text-3xl p-3 bg-slate-800/60 rounded-xl border border-slate-700/50 group-hover:scale-110 transition-transform">
            {service.icon}
          </span>
          <span class="text-xs font-semibold px-3 py-1 bg-indigo-950/60 border border-indigo-500/20 text-indigo-300 rounded-full">
            {service.tag}
          </span>
        </div>
        <h3 class="text-xl font-bold text-white mb-3 group-hover:text-indigo-300 transition-colors">
          {service.title}
        </h3>
        <p class="text-slate-400 leading-relaxed text-sm md:text-base">
          {service.description}
        </p>
      </div>
    ))}
  </div>
</section>