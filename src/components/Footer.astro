---
// src/components/Footer.astro
---

<footer class="bg-slate-950 py-16 border-t border-slate-900">
  <div class="w-full max-w-7xl mx-auto px-6 md:px-12 lg:px-16 text-center md:text-left grid grid-cols-1 md:grid-cols-3 gap-12">
    <div>
      <div class="text-2xl font-bold tracking-tight text-slate-100 mb-4">
        <span class="text-indigo-400">Web</span>Build
      </div>
      <p class="text-slate-400 text-base">Premium digital presence for independent brands.</p>
    </div>
    <div>
      <h4 class="text-slate-100 font-semibold text-lg mb-4">Quick Links</h4>
      <ul class="space-y-3 text-base text-slate-400">
        <li><a href="#services" class="hover:text-indigo-400 transition-colors">Services</a></li>
        <li><a href="#pricing" class="hover:text-indigo-400 transition-colors">Pricing</a></li>
        <li><a href="#contact" class="hover:text-indigo-400 transition-colors">Contact</a></li>
      </ul>
    </div>
    <div>
      <h4 class="text-slate-100 font-semibold text-lg mb-4">Legal</h4>
      <ul class="space-y-3 text-base text-slate-400">
        <li><a href="#" class="hover:text-indigo-400 transition-colors">Privacy Policy</a></li>
        <li><a href="#" class="hover:text-indigo-400 transition-colors">Terms of Service</a></li>
      </ul>
    </div>
  </div>
  <div class="w-full max-w-7xl mx-auto px-6 md:px-12 lg:px-16 mt-16 pt-8 border-t border-slate-900 text-center text-base text-slate-500">
    &copy; {new Date().getFullYear()} WebBuild. All rights reserved.
  </div>
</footer>