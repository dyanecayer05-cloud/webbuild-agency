      <div class="hidden md:flex items-center gap-8 text-sm font-medium">
        <a href="#services" class="text-neutral-400 hover:text-white transition-colors">Services</a>
        <a href="#process" class="text-neutral-400 hover:text-white transition-colors">Process</a>
        <a href="#pricing" class="text-neutral-400 hover:text-white transition-colors">Pricing</a>
