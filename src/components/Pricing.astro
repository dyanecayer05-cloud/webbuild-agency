---
// src/components/Pricing.astro
---

<section id="pricing" class="w-full max-w-7xl mx-auto px-6 md:px-12 lg:px-16 py-24 scroll-mt-20">
  <div class="text-center mb-16">
    <h2 class="text-4xl md:text-5xl font-bold text-white tracking-tight">Transparent, accessible <span class="text-purple-400">pricing</span>.</h2>
    <p class="text-neutral-400 text-base md:text-lg mt-3 max-w-2xl mx-auto">High-performance web engineering shouldn't require a massive loan. Choose a discounted flat rate or split it into 0% interest monthly payments.</p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
    
    <div class="group relative rounded-2xl border border-white/[0.03] bg-[#0b121f]/10 p-8 md:p-10 backdrop-blur-md transition-all duration-300 hover:scale-[1.02] hover:border-blue-500/40 hover:shadow-[0_0_40px_rgba(59,130,246,0.15)] flex flex-col justify-between">
      <div>
        <h3 class="text-xl font-bold text-white mb-2">The Essentials</h3>
        <p class="text-neutral-400 text-xs mb-8">Perfect for local trades & independent creators.</p>
        
        <div class="mb-8">
          <span class="text-4xl font-bold text-white">$85</span><span class="text-neutral-400 text-sm">/mo</span>
          <div class="text-xs text-green-400 font-medium mt-1">or $900 flat rate <span class="underline">(Save $120)</span></div>
        </div>

        <div class="w-full h-[1px] bg-neutral-800 mb-8"></div>

        <ul class="space-y-4 text-neutral-300 text-sm">
          <li class="flex items-center gap-2"><span class="text-blue-400 font-bold">✓</span> 5-Page High-Performance Site</li>
          <li class="flex items-center gap-2"><span class="text-blue-400 font-bold">✓</span> Mobile & Tablet Responsive</li>
          <li class="flex items-center gap-2"><span class="text-blue-400 font-bold">✓</span> Custom Contact Form Node</li>
          <li class="flex items-center gap-2"><span class="text-blue-400 font-bold">✓</span> Standard SEO Optimization</li>
        </ul>
      </div>
      <a href="#contact" class="block w-full mt-8 py-3 rounded-lg bg-neutral-900 border border-neutral-800 hover:border-blue-500/50 hover:bg-blue-950/20 text-white font-medium text-sm text-center transition-all duration-300">Get Started</a>
    </div>

    <div class="group relative rounded-2xl border border-purple-500/30 bg-[#130f1c]/20 p-8 md:p-10 backdrop-blur-md shadow-[0_0_30px_rgba(168,85,247,0.04)] transition-all duration-300 hover:scale-[1.04] hover:border-purple-500/60 hover:shadow-[0_0_50px_rgba(168,85,247,0.2)] flex flex-col justify-between">
      <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-purple-500 text-black text-[10px] font-mono tracking-widest font-bold px-3 py-1 rounded-full uppercase shadow-lg shadow-purple-500/20">
        Most Popular
      </div>
      <div>
        <h3 class="text-xl font-bold text-white mb-2">The Growth</h3>
        <p class="text-neutral-400 text-xs mb-8">For emerging startups needing more power.</p>
        
        <div class="mb-8">
          <span class="text-4xl font-bold text-white">$170</span><span class="text-neutral-400 text-sm">/mo</span>
          <div class="text-xs text-green-400 font-medium mt-1">or $1,800 flat rate <span class="underline">(Save $240)</span></div>
        </div>

        <div class="w-full h-[1px] bg-neutral-800/80 mb-8"></div>

        <ul class="space-y-4 text-neutral-200 text-sm">
          <li class="flex items-center gap-2"><span class="text-purple-400 font-bold">✓</span> Everything in Essentials</li>
          <li class="flex items-center gap-2"><span class="text-purple-400 font-bold">✓</span> Content Management System (CMS)</li>
          <li class="flex items-center gap-2"><span class="text-purple-400 font-bold">✓</span> Custom E-Commerce Configurations</li>
          <li class="flex items-center gap-2"><span class="text-purple-400 font-bold">✓</span> Advanced Dynamic Interaction Elements</li>
        </ul>
      </div>
      <a href="#contact" class="block w-full mt-8 py-3 rounded-lg bg-purple-500 hover:bg-purple-600 text-black font-bold text-sm text-center shadow-xl shadow-purple-500/10 transition-all duration-300">Start Growth Plan</a>
    </div>

    <div class="group relative rounded-2xl border border-white/[0.03] bg-[#0c1612]/20 p-8 md:p-10 backdrop-blur-md transition-all duration-300 hover:scale-[1.02] hover:border-green-500/40 hover:shadow-[0_0_40px_rgba(34,197,94,0.15)] flex flex-col justify-between">
      <div>
        <h3 class="text-xl font-bold text-white mb-2">Custom Architecture</h3>
        <p class="text-neutral-400 text-xs mb-8">For complex needs and web applications.</p>
        
        <div class="mb-8">
          <span class="text-4xl font-bold text-white">Custom</span>
          <div class="text-xs text-neutral-400 font-medium mt-1">Tailored to your scope blueprint</div>
        </div>

        <div class="w-full h-[1px] bg-neutral-800 mb-8"></div>

        <ul class="space-y-4 text-neutral-300 text-sm">
          <li class="flex items-center gap-2"><span class="text-green-400 font-bold">✓</span> Private Server Infrastructures</li>
          <li class="flex items-center gap-2"><span class="text-green-400 font-bold">✓</span> Complex Database Solutions</li>
          <li class="flex items-center gap-2"><span class="text-green-400 font-bold">✓</span> API & Webhook Implementations</li>
          <li class="flex items-center gap-2"><span class="text-green-400 font-bold">✓</span> Priority Technical Support Nodes</li>
        </ul>
      </div>
      <a href="#contact" class="block w-full mt-8 py-3 rounded-lg bg-neutral-900 border border-neutral-800 hover:border-green-500/50 hover:bg-green-950/20 text-white font-medium text-sm text-center transition-all duration-300">Contact Scope</a>
    </div>

  </div>
</section>
