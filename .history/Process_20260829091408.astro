---
// src/components/Process.astro
const steps = [
  {
    step: "01",
    title: "Submit the Brief",
    desc: "Fill out the quick intake form below with your goals, service area, and design preferences. No lengthy discovery sales calls required."
  },
  {
    step: "02",
    title: "Engineering Sprint",
    desc: "We build your custom, mobile-first static architecture, configure local search metadata, and optimize for 100/100 Core Web Vitals."
  },
  {
    step: "03",
    title: "Live Production Launch",
    desc: "We connect your custom domain, provision automated SSL encryption, and hand over a live, high-converting digital asset."
  }
];
---

<section id="process" class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24 md:py-32 scroll-mt-20 md:scroll-mt-24 border-t border-slate-800/50">  <div class="max-w-3xl mb-16">
    <div class="text-xs uppercase tracking-widest text-indigo-400 font-bold mb-3">Our Process</div>
    <h2 class="text-3xl md:text-5xl font-extrabold tracking-tight text-white mb-4">
      What We Do.
    </h2>
    <p class="text-lg md:text-xl text-slate-300 leading-relaxed">
      We bridge the gap between <span class="text-indigo-400 font-semibold">modern engineering</span> and local business.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    {steps.map((item) => (
      <div class="bg-slate-900/40 border border-slate-800/80 rounded-2xl p-8 relative hover:border-indigo-500/40 transition">
        <span class="text-4xl font-black text-indigo-500/40 mb-4 block font-mono">{item.step}</span>
        <h3 class="text-xl font-bold text-white mb-3">{item.title}</h3>
        <p class="text-slate-400 leading-relaxed text-sm md:text-base">{item.desc}</p>
      </div>
    ))}
  </div>
</section>