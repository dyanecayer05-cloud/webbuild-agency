---
// src/components/Hero.astro
---

<section id="hero" class="max-w-6xl mx-auto px-4 py-20 md:py-32 flex flex-col items-center text-center">
  <div class="flex flex-col items-center gap-3 mb-8">
    <span class="text-xs font-bold tracking-widest text-indigo-400 uppercase bg-indigo-500/10 px-4 py-1.5 rounded-full border border-indigo-500/20">
      Small Business Supporting Small Businesses
    </span>
    <span class="text-sm font-medium text-slate-400">
      Proudly based in NC, building for the world.
    </span>
  </div>
  
  <h1 class="text-4xl md:text-6xl font-bold tracking-tight max-w-4xl leading-tight text-slate-100">
    Premium digital presence, built to lift up <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 via-violet-400 to-fuchsia-400">any vision, anywhere</span>.
  </h1>
  
  <p class="mt-6 text-lg md:text-xl text-slate-400 max-w-2xl leading-relaxed">
    Whether you're a local trade, an emerging startup, or an independent creator. No massive agency price tags. Just clean, high-performance web engineering to help you thrive.
  </p>
  
  <div class="mt-10 flex flex-wrap justify-center gap-4">
    <a 
      href="#contact" 
      class="px-8 py-3.5 bg-indigo-500 hover:bg-indigo-400 text-white font-semibold rounded-xl transition-all duration-300 shadow-[0_0_15px_rgba(99,102,241,0.3)] hover:shadow-[0_0_25px_rgba(99,102,241,0.6)] transform hover:-translate-y-0.5"
    >
      Start Your Project
    </a>
    <a 
      href="#services" 
      class="px-8 py-3.5 bg-slate-900/80 hover:bg-slate-800 text-slate-200 font-medium rounded-xl transition-all duration-300 border border-slate-700/60 hover:border-slate-500 hover:shadow-[0_0_20px_rgba(255,255,255,0.05)] transform hover:-translate-y-0.5"
    >
      View Services
    </a>
  </div>
</section>