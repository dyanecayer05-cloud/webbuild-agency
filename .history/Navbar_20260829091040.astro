---
// src/components/Navbar.astro
---

<header class="sticky top-0 z-50 w-full bg-slate-950/90 backdrop-blur-md border-b border-slate-800/80">
  <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
    <!-- Brand Logo / Top Link -->
    <a href="#home" class="text-lg md:text-xl font-extrabold tracking-tight text-white flex items-center gap-1.5">
      <span class="text-indigo-400">WebBuild:</span>
      <span class="text-slate-200">By CraftandCode</span>
    </a>

    <!-- Navigation Links -->
    <nav class="flex items-center gap-4 sm:gap-8 text-xs sm:text-sm font-semibold text-slate-300">
      <a href="#home" class="hover:text-indigo-400 transition-colors">Home</a>
      <a href="#process" class="hover:text-indigo-400 transition-colors">Process</a>
      <a href="#pricing" class="hover:text-indigo-400 transition-colors">Pricing</a>
      <a href="#about" class="hover:text-indigo-400 transition-colors">About</a>
    </nav>

    <!-- CTA Button -->
    <div class="hidden sm:block">
      <a 
        href="#contact" 
        class="bg-indigo-600 hover:bg-indigo-500 text-white text-xs sm:text-sm font-bold px-4 py-2.5 rounded-xl shadow-lg shadow-indigo-600/20 transition-all inline-block"
      >
        Start Project
      </a>
    </div>
  </div>
</header>