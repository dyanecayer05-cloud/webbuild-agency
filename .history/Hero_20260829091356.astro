---
// src/components/Hero.astro
---

<section id="home" class="w-full max-w-6xl mx-auto px-4 sm:px-6 py-16 sm:py-24 md:py-32 flex flex-col items-center text-center scroll-mt-20 md:scroll-mt-24">  <div class="flex flex-col items-center gap-2 mb-8">
    <span class="text-xs font-bold tracking-widest text-indigo-400 uppercase bg-indigo-500/10 px-4 py-1.5 rounded-full border border-indigo-500/20">
      Small Business Supporting Small Businesses
    </span>
    <span class="text-sm font-medium text-slate-400">
      Proudly based in NC, building for the world.
    </span>
  </div>
  
  <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight max-w-4xl leading-tight text-white">
    Premium digital presence, built to lift up <span class="text-indigo-400">any vision, anywhere</span>.
  </h1>
  
  <p class="mt-6 text-lg md:text-xl text-slate-400 max-w-2xl leading-relaxed">
    Whether you're a local trade, an emerging startup, or an independent creator. No massive agency price tags. Just clean, high-performance web engineering to help you thrive.
  </p>
  
  <div class="mt-10 flex flex-wrap justify-center gap-4">
    <a 
      href="#contact" 
      class="px-8 py-3.5 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold rounded-xl shadow-lg shadow-indigo-600/25 transition-all transform hover:-translate-y-0.5"
    >
      Start Your Project
    </a>
    <a 
      href="#process" 
      class="px-8 py-3.5 bg-slate-900 hover:bg-slate-800 text-slate-200 font-medium rounded-xl border border-slate-700 transition-all transform hover:-translate-y-0.5"
    >
      Our Process
    </a>
  </div>
</section>