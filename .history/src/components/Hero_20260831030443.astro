---
// src/components/Hero.astro
---

<section id="home" class="relative w-full max-w-6xl mx-auto px-6 pt-24 pb-32 flex flex-col items-center text-center scroll-mt-24 overflow-visible">
  
  <!-- High-Vibrancy Neon Ambient Spotlight -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[550px] h-[300px] bg-gradient-to-tr from-indigo-600/30 via-fuchsia-500/20 to-cyan-400/20 blur-[130px] -z-10 pointer-events-none"></div>

  <!-- Status Pill Badge -->
  <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full border border-indigo-500/30 bg-indigo-950/40 backdrop-blur-xl mb-8 shadow-[0_0_20px_rgba(99,102,241,0.2)]">
    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
    <span class="text-xs font-bold uppercase tracking-wider text-slate-200 font-mono">Small Business Supporting Small Businesses</span>
    <span class="text-indigo-400">•</span>
    <span class="text-xs font-bold text-indigo-300">NC & Nationwide</span>
  </div>
  
  <!-- High-Voltage Electric Headline -->
  <h1 class="font-display text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white max-w-5xl leading-[1.1] drop-shadow-sm">
    Premium web engineering, built to elevate <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-indigo-400 to-fuchsia-400 animate-pulse">any vision, anywhere.</span>
  </h1>
  
  <!-- Subheading -->
  <p class="mt-8 text-lg sm:text-xl text-slate-300 max-w-2xl font-normal leading-relaxed">
    Bespoke static architecture designed for local trades, emerging creators, and modern businesses. No bloated agency retainers, no WordPress slowdowns, and zero sales calls.
  </p>
  
  <!-- Glowing Action Buttons -->
  <div class="mt-12 flex flex-wrap justify-center items-center gap-5">
    <a 
      href="#contact" 
      class="relative group px-9 py-4 rounded-xl bg-gradient-to-r from-indigo-600 via-indigo-500 to-purple-600 text-white font-bold text-sm sm:text-base shadow-[0_0_35px_rgba(99,102,241,0.5)] hover:shadow-[0_0_55px_rgba(99,102,241,0.85)] transition-all duration-300 transform hover:-translate-y-1"
    >
      Start Your Project
    </a>
    <a 
      href="#process" 
      class="px-8 py-4 rounded-xl bg-slate-900/90 hover:bg-slate-800/90 text-slate-200 font-semibold text-sm sm:text-base border border-slate-700 hover:border-indigo-400/60 shadow-[0_0_20px_rgba(0,0,0,0.4)] backdrop-blur-md transition-all duration-300 transform hover:-translate-y-1"
    >
      Explore How It Works
    </a>
  </div>
</section>