---
// src/components/Hero.astro
---

<section id="home" class="relative max-w-6xl mx-auto px-6 pt-24 pb-32 flex flex-col items-center text-center scroll-mt-24">
  <!-- Status Badge -->
  <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-white/[0.08] bg-white/[0.03] backdrop-blur-md mb-8">
    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
    <span class="text-xs font-medium text-gray-300">Small Business Supporting Small Businesses</span>
    <span class="text-gray-600">•</span>
    <span class="text-xs font-semibold text-indigo-400">NC & Nationwide</span>
  </div>
  
  <!-- Headline -->
  <h1 class="font-display text-4xl sm:text-6xl lg:text-7xl font-bold tracking-tight text-white max-w-4xl leading-[1.1]">
    Premium web engineering, built to elevate <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-300 via-indigo-100 to-purple-300">any vision, anywhere.</span>
  </h1>
  
  <p class="mt-8 text-lg sm:text-xl text-gray-400 max-w-2xl font-normal leading-relaxed">
    Bespoke static architecture designed for local trades, emerging creators, and modern businesses. No bloated agency overhead or endless meetings.
  </p>
  
  <!-- Action Controls -->
  <div class="mt-12 flex flex-wrap justify-center items-center gap-4">
    <a 
      href="#contact" 
      class="px-8 py-4 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-sm shadow-[0_0_30px_rgba(79,70,229,0.35)] hover:shadow-[0_0_40px_rgba(79,70,229,0.6)] transition duration-200 transform hover:-translate-y-0.5"
    >
      Start Your Project
    </a>
    <a 
      href="#process" 
      class="px-8 py-4 rounded-xl bg-white/[0.03] hover:bg-white/[0.08] text-gray-200 font-medium text-sm border border-white/[0.1] backdrop-blur-sm transition duration-200 transform hover:-translate-y-0.5"
    >
      Explore How It Works
    </a>
  </div>
</section>