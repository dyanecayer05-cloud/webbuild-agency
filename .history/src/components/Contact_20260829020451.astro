---
// src/components/Contact.astro
---

<section id="contact" class="w-full max-w-7xl mx-auto px-6 md:px-12 lg:px-16 py-32 border-t border-slate-800/40">
  <div class="text-center max-w-4xl mx-auto mb-20">
    <h2 class="text-4xl md:text-6xl font-bold tracking-tight text-slate-100 mb-6 leading-tight">Let's build it. <br/><span class="text-indigo-400 text-3xl md:text-4xl font-normal">(No meetings required.)</span></h2>
    <p class="text-lg md:text-xl text-slate-400 leading-relaxed font-normal">
      We respect your time. All project communication is handled efficiently via email, text, or WhatsApp. No phone calls, no awkward video meetings—just clear, documented progress. Fill out the brief below to get started.
    </p>
  </div>

  <div class="w-full max-w-5xl mx-auto bg-slate-800/20 backdrop-blur-xl border border-slate-700/40 rounded-3xl p-10 md:p-16 shadow-2xl relative overflow-hidden">
    <form action="https://api.web3forms.com/submit" method="POST" class="relative z-10 space-y-10">
      
      <!-- Web3Forms Config -->
      <input type="hidden" name="access_key" value="0145ef00-cc12-4dd4-b1d5-d7076344a770" />
      <input type="hidden" name="subject" value="New Project Inquiry - Craft & Code" />
      <input type="hidden" name="redirect" value="https://craftandcode.dev/thank-you" />
      <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
        <div>
          <label class="block text-base font-semibold text-slate-300 mb-3">Name</label>
          <input type="text" name="name" required placeholder="John Doe" class="w-full bg-slate-900/60 border border-slate-700/60 rounded-xl px-5 py-4 text-slate-100 text-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all shadow-inner">
        </div>
        <div>
          <label class="block text-base font-semibold text-slate-300 mb-3">Email Address</label>
          <input type="email" name="email" required placeholder="john@example.com" class="w-full bg-slate-900/60 border border-slate-700/60 rounded-xl px-5 py-4 text-slate-100 text-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all shadow-inner">
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
        <div>
          <label class="block text-base font-semibold text-slate-300 mb-3">What do you need built?</label>
          <div class="relative">
            <select name="project_type" required class="w-full bg-slate-900/60 border border-slate-700/60 rounded-xl px-5 py-4 text-slate-100 text-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all shadow-inner appearance-none cursor-pointer">
              <option value="" disabled selected>Select an option...</option>
              <option value="Standard Website">A standard business website</option>
              <option value="E-Commerce">An e-commerce storefront</option>
              <option value="Web App / Custom">A custom web application</option>
              <option value="Redesign">A redesign of my current site</option>
            </select>
          </div>
        </div>
        <div>
          <label class="block text-base font-semibold text-slate-300 mb-3">What is your estimated timeline?</label>
          <div class="relative">
            <select name="timeline" required class="w-full bg-slate-900/60 border border-slate-700/60 rounded-xl px-5 py-4 text-slate-100 text-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all shadow-inner appearance-none cursor-pointer">
              <option value="" disabled selected>Select a timeline...</option>
              <option value="ASAP">As soon as possible</option>
              <option value="1-2 Months">Within 1-2 months</option>
              <option value="Flexible">I am flexible / Just exploring</option>
            </select>
          </div>
        </div>
      </div>

      <div>
        <label class="block text-base font-semibold text-slate-300 mb-3">Logo, Design Inspiration, or Brief Link (Optional)</label>
        <input type="url" name="asset_link" placeholder="https://drive.google.com/..., Figma, or Dropbox link" class="w-full bg-slate-900/60 border border-slate-700/60 rounded-xl px-5 py-4 text-slate-100 text-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all shadow-inner placeholder-slate-600">
      </div>

      <div>
        <label class="block text-base font-semibold text-slate-300 mb-3">Additional Project Details (Optional)</label>
        <textarea name="message" rows="4" class="w-full bg-slate-900/60 border border-slate-700/60 rounded-xl px-5 py-4 text-slate-100 text-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all shadow-inner placeholder-slate-600" placeholder="Tell us about your brand, current site issues, or specific must-have features..."></textarea>
      </div>

      <button type="submit" class="w-full bg-linear-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 text-white font-bold py-4 px-8 rounded-xl text-lg transition-all duration-300 shadow-[0_0_20px_rgba(79,70,229,0.3)] hover:shadow-[0_0_40px_rgba(79,70,229,0.5)] transform hover:-translate-y-1">
        Send Project Inquiry
      </button>
    </form>
  </div>
</section>