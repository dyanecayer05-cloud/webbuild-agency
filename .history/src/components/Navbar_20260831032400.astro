---
// src/components/Navbar.astro
---

<header class="sticky top-0 z-50 w-full bg-slate-950/80 backdrop-blur-xl border-b border-white/[0.08]">
  <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
    
    <!-- Brand Identity with Custom Monogram -->
    <a href="#home" class="flex items-center gap-3 group">
      <div class="relative flex items-center justify-center w-9 h-9 rounded-xl bg-gradient-to-br from-indigo-500/20 to-purple-500/10 border border-indigo-500/40 shadow-[0_0_15px_rgba(99,102,241,0.25)] group-hover:shadow-[0_0_25px_rgba(99,102,241,0.5)] group-hover:border-indigo-400 transition-all duration-300">
        <svg class="w-5 h-5 text-indigo-400 group-hover:text-cyan-300 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16.5 9.4 7.55 4.24a1.78 1.78 0 0 0-2.5 1.55v12.42a1.78 1.78 0 0 0 2.5 1.55L16.5 14.6a1.78 1.78 0 0 0 0-3.2z" fill="currentColor" fill-opacity="0.15" />
          <path d="m18 15 3-3-3-3" />
          <path d="m6 9-3 3 3 3" />
        </svg>
      </div>
      <div>
        <span class="font-display font-extrabold text-lg tracking-tight text-white group-hover:text-indigo-200 transition">
          Craft & Code
        </span>
        <span class="block text-[10px] font-mono tracking-widest text-indigo-400 uppercase -mt-1 font-semibold">
          Web Systems
        </span>
      </div>
    </a>

    <!-- Navigation Links -->
    <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-300">
      <a href="#home" class="hover:text-white transition-colors">Home</a>
      <a href="#about" class="hover:text-white transition-colors">About</a>
      <a href="#features" class="hover:text-white transition-colors">Features</a>
      <a href="#process" class="hover:text-white transition-colors">Process</a>
      <a href="#pricing" class="hover:text-white transition-colors">Pricing</a>
    </nav>

    <!-- Standalone Glow CTA -->
    <div class="flex items-center gap-4">
      <a 
        href="#contact" 
        class="relative inline-flex items-center justify-center px-6 py-2.5 rounded-full font-semibold text-xs sm:text-sm text-white bg-gradient-to-r from-indigo-600 via-indigo-500 to-purple-600 shadow-[0_0_20px_rgba(99,102,241,0.35)] hover:shadow-[0_0_30px_rgba(99,102,241,0.7)] hover:scale-[1.02] active:scale-[0.98] transition-all duration-200"
      >
        Start Project
      </a>
    </div>
  </div>
</header>