---
// src/components/About.astro
const audiences = [
  {
    icon: "💼",
    title: "Local Trades & Shops",
    desc: "Plumbers, bakeries, and boutiques who need to turn local searches into booked jobs and real foot traffic."
  },
  {
    icon: "⚡",
    title: "Startups & Creators",
    desc: "Independent brands that need a sleek, high-end digital presence to attract investors or new followers."
  },
  {
    icon: "🛍️",
    title: "E-Commerce Brands",
    desc: "Retailers ready to bypass marketplace fees and sell directly to customers on their own custom platform."
  }
];
---

<section id="about" class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-32 scroll-mt-24 border-t border-slate-800/60">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
    <!-- Left Column: Mission & Positioning -->
    <div class="lg:col-span-6">
      <div class="text-xs uppercase tracking-widest text-indigo-400 font-bold mb-3">About WebBuild</div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-white leading-tight mb-6">
        We bridge the gap between <span class="text-indigo-400">enterprise engineering</span> and local business.
      </h2>
      <p class="text-base sm:text-lg text-slate-300 leading-relaxed mb-6">
        Most web agencies overcomplicate the process to justify massive invoices. We do the opposite. We use modern, high-performance static engineering to build lightning-fast websites, packaged into simple, transparent pricing.
      </p>
      <p class="text-sm sm:text-base text-slate-400 leading-relaxed">
        Whether you need a high-converting landing page or a full digital platform, every build is engineered from scratch for speed, search visibility, and maximum conversion.
      </p>
    </div>

    <!-- Right Column: Target Audience Cards -->
    <div class="lg:col-span-6 space-y-4">
      {audiences.map((item) => (
        <div class="bg-slate-900/60 border border-slate-800/90 rounded-2xl p-6 hover:border-indigo-500/40 transition-all">
          <div class="flex items-center gap-3 mb-2">
            <span class="text-xl">{item.icon}</span>
            <h3 class="text-lg font-bold text-white">{item.title}</h3>
          </div>
          <p class="text-sm text-slate-400 leading-relaxed pl-8">
            {item.desc}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>