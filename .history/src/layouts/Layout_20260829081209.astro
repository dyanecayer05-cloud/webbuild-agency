---
// src/pages/index.astro
import { title } from 'process';
import Contact from '../../Contact.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="WebBuild: By CraftandCode | High-Performance Modern Web Engineering"
  description="Fast, bespoke websites engineered for local businesses with zero bloated sales calls."
>
  <main class="min-h-screen flex flex-col items-center justify-center px-6 py-24 bg-slate-950 text-slate-100">
    <div class="max-w-4xl w-full text-center">
      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight mb-6 leading-tight">High-performance websites engineered for local businesses.</h1>
      <p class="text-lg md:text-xl text-slate-400 leading-relaxed mb-12">
        We build fast, bespoke websites with zero bloated sales calls. Fill out the brief below to get started.
      </p>
    </div>

    <Contact />
  </main>

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <!-- is:inline tells Astro to load Tailwind directly in the browser -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
      tailwind.config = {
        darkMode: 'class',
        theme: {
          extend: {
            colors: {
              brand: '#6366f1'
            }
          }
        }
      }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  </head>
  <body class="bg-slate-950 text-slate-100 font-['Plus_Jakarta_Sans',sans-serif] antialiased min-h-screen selection:bg-indigo-500 selection:text-white">
    <slot />
  </body>
</html>