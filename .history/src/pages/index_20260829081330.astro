---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Contact from '../components/Contact.astro';
---

<Layout 
  title="WebBuild: By CraftandCode | High-Performance Modern Web Engineering"
  description="Fast, bespoke websites engineered for local businesses with zero bloated sales calls."
>
  <main class="min-h-screen flex flex-col items-center justify-center px-6 py-24 bg-slate-950 text-slate-100">
    <div class="max-w-4xl w-full text-center">
      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight mb-6 leading-tight">
        High-performance websites engineered for local businesses.
      </h1>
      <p class="text-lg md:text-xl text-slate-400 leading-relaxed mb-12">
        We build fast, bespoke websites with zero bloated sales calls. Fill out the brief below to get started.
      </p>
    </div>

    <Contact />
  </main>
</Layout>