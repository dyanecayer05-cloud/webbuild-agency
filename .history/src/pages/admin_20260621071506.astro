---
// src/pages/admin.astro
import { UserButton } from '@clerk/astro/components';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Agency OS | Admin Dashboard</title>
</head>
<body class="bg-[#0a0a0a] text-slate-200 font-sans antialiased flex h-screen overflow-hidden">

  <!-- Admin Sidebar -->
  <aside class="w-64 bg-slate-900/50 border-r border-slate-800 flex flex-col justify-between">
    <div class="p-6">
      <h1 class="text-xl font-bold text-white mb-8">Agency <span class="text-indigo-400">OS</span></h1>
      <nav class="space-y-2">
        <a href="#" class="block px-4 py-3 bg-indigo-500/10 text-indigo-400 rounded-lg border border-indigo-500/20 font-medium">📥 Inquiries & Comms</a>
        <a href="#" class="block px-4 py-3 text-slate-400 hover:bg-slate-800/50 hover:text-slate-200 rounded-lg transition-colors">📄 Contracts & Legal</a>
        <a href="#" class="block px-4 py-3 text-slate-400 hover:bg-slate-800/50 hover:text-slate-200 rounded-lg transition-colors">🏗️ Web Builder</a>
        <a href="#" class="block px-4 py-3 text-slate-400 hover:bg-slate-800/50 hover:text-slate-200 rounded-lg transition-colors">💼 Tax & Finance</a>
        <a href="#" class="block px-4 py-3 text-slate-400 hover:bg-slate-800/50 hover:text-slate-200 rounded-lg transition-colors">🤖 AI Assistant</a>
      </nav>
    </div>
    <div class="p-6 border-t border-slate-800">
      <a href="/" class="text-sm text-slate-500 hover:text-slate-300">← Back to Live Site</a>
    </div>
	<div class="p-6 flex items-center justify-between">
  		<h1 class="text-xl font-bold text-white">Agency <span class="text-indigo-400">OS</span></h1>
  		<UserButton />
	</div>
  </aside>

  <!-- Main Dashboard Content -->
  <main class="flex-1 flex flex-col h-full overflow-y-auto">
    <header class="h-20 border-b border-slate-800 flex items-center px-8 bg-slate-900/20">
      <h2 class="text-2xl font-semibold text-slate-100">Inquiry Response Generator</h2>
    </header>

    <div class="p-8 max-w-5xl">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Controls Column -->
        <div class="lg:col-span-1 space-y-6">
          <div class="bg-slate-900/50 border border-slate-800 p-6 rounded-xl">
            <h3 class="font-semibold text-slate-200 mb-4">Client Details</h3>
            <div class="space-y-4">
              <div>
                <label class="block text-sm text-slate-400 mb-1">Client Name</label>
                <input type="text" id="clientName" placeholder="e.g. Sarah" class="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-indigo-500">
              </div>
              <div>
                <label class="block text-sm text-slate-400 mb-1">Business Type</label>
                <input type="text" id="businessType" placeholder="e.g. Bakery" class="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-indigo-500">
              </div>
            </div>
          </div>

          <div class="bg-slate-900/50 border border-slate-800 p-6 rounded-xl">
            <h3 class="font-semibold text-slate-200 mb-4">Select Template</h3>
            <div class="space-y-2">
              <button onclick="loadTemplate('ecommerce')" class="w-full text-left px-4 py-3 bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded-lg transition-colors text-sm">🛍️ E-Commerce Deep Dive</button>
              <button onclick="loadTemplate('standard')" class="w-full text-left px-4 py-3 bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded-lg transition-colors text-sm">🏢 Standard Business Build</button>
              <button onclick="loadTemplate('custom')" class="w-full text-left px-4 py-3 bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded-lg transition-colors text-sm">⚙️ Custom App Architecture</button>
            </div>
          </div>
        </div>

        <!-- Template Editor Column -->
        <div class="lg:col-span-2">
          <div class="bg-slate-900/50 border border-slate-800 rounded-xl flex flex-col h-150">
            <div class="p-4 border-b border-slate-800 flex justify-between items-center bg-slate-800/30">
              <span class="text-sm font-medium text-slate-300">Generated Response</span>
              <button id="copyBtn" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-medium rounded-lg transition-colors">Copy to Clipboard</button>
            </div>
            <textarea id="templateOutput" class="flex-1 w-full bg-transparent p-6 text-slate-300 resize-none focus:outline-none leading-relaxed" placeholder="Select a template on the left..."></textarea>
          </div>
        </div>

      </div>
    </div>
  </main>

  <script is:inline>
    const templates = {
      ecommerce: `Hi [Name],\n\nThanks for reaching out about building a web presence for your [Business]. \n\nTo ensure we engineer this perfectly without wasting your time on phone calls, we handle all project mapping asynchronously. Below is our deep-dive questionnaire. Please reply with your answers so I can draft your technical proposal and contract.\n\n1. Product Catalog: Roughly how many physical or digital items will you be selling?\n2. Payment Gateway: Do you currently use Stripe, Square, PayPal, or something else?\n3. Shipping: Do you need complex shipping logic (weight-based, international), or standard flat rates?\n4. Assets: Do you have high-res photography of your products ready to go?\n\nOnce you send this back, I will provide a custom quote and our standard development contract. \n\nBest,\nWeb Build Agency`,
      
      standard: `Hi [Name],\n\nThanks for reaching out about a new site for your [Business]. \n\nWe specialize in high-performance, async-driven development. This means no mandatory Zoom meetings—just clean code and clear email communication. \n\nTo get started on your technical proposal, please reply with the following:\n\n1. Structure: What pages do you absolutely need? (e.g., Home, About, Services, Contact)\n2. Inspiration: Are there 2-3 websites in your industry that you love the look of?\n3. Content: Do you have the written text for the site, or will we need to assist with copywriting?\n4. Timeline: Are there any hard deadlines we need to hit?\n\nLooking forward to reviewing your answers and sending over the project contract.\n\nBest,\nWeb Build Agency`,
      
      custom: `Hi [Name],\n\nThanks for inquiring about custom architecture for your [Business]. \n\nComplex applications require strict engineering parameters. Because we operate entirely async, we need a highly detailed brief before we can quote this project.\n\nPlease reply with a detailed scope of work including:\n- Required database structures (what user data are we storing?)\n- Third-party API integrations needed\n- User authentication requirements\n\nOnce we have the technical map, I will send over a master services agreement.\n\nBest,\nWeb Build Agency`
    };

    function loadTemplate(type) {
      const name = document.getElementById('clientName').value || '[Name]';
      const business = document.getElementById('businessType').value || '[Business]';
      
      let rawText = templates[type];
      let personalizedText = rawText.replace(/\[Name\]/g, name).replace(/\[Business\]/g, business);
      
      document.getElementById('templateOutput').value = personalizedText;
    }

    document.getElementById('copyBtn').addEventListener('click', () => {
      const text = document.getElementById('templateOutput');
      text.select();
      navigator.clipboard.writeText(text.value);
      alert('Template copied to clipboard!');
    });
  </script>

  <!-- Tailwind CDN just for this admin page to ensure isolated styling -->
  <script src="https://cdn.tailwindcss.com"></script>
</body>
</html>