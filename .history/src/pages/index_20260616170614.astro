---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Affordable Web Design for Small Businesses";
---

<Layout title={pageTitle}>
	<header class="fixed top-0 w-full z-50 bg-slate-900/80 backdrop-blur-md border-b border-slate-800">
		<div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
			<div class="text-xl font-bold tracking-tight text-slate-100">
				<span class="text-teal-400">Web</span>Build
			</div>
			<nav class="hidden md:flex gap-6 text-sm font-medium text-slate-300">
				<a href="#features" class="hover:text-teal-400 transition-colors">Features</a>
				<a href="#pricing" class="hover:text-teal-400 transition-colors">Pricing</a>
				<a href="#contact" class="hover:text-teal-400 transition-colors">Contact</a>
			</nav>
			<a href="#contact" class="px-4 py-2 text-sm font-semibold bg-teal-500 hover:bg-teal-400 text-slate-900 rounded transition-colors">
				Get Started
			</a>
		</div>
	</header>

	<main class="min-h-screen bg-slate-900 text-slate-100 font-sans pt-16">
		
		<section class="max-w-6xl mx-auto px-4 py-20 md:py-32 flex flex-col items-center text-center">
			<span class="text-sm font-semibold tracking-wider text-teal-400 uppercase bg-teal-400/10 px-3 py-1 rounded-full mb-6">
				Now Serving Our Community
			</span>
			<h1 class="text-4xl md:text-6xl font-bold tracking-tight max-w-3xl leading-tight text-slate-100">
				Premium digital presence, built to lift up <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-400 to-emerald-400">local businesses</span>.
			</h1>
			<p class="mt-6 text-lg md:text-xl text-slate-400 max-w-2xl">
				No corporate overhead. No massive agency price tags. Just clean, high-performance web engineering to help your shop, trade, or boutique thrive.
			</p>
			<div class="mt-10 flex flex-wrap justify-center gap-4">
				<a href="#contact" class="px-6 py-3 bg-teal-500 hover:bg-teal-400 text-slate-950 font-medium rounded-lg transition-colors duration-200">
					Start Your Project
				</a>
				<a href="#features" class="px-6 py-3 bg-slate-800 hover:bg-slate-700 text-slate-200 font-medium rounded-lg transition-colors duration-200 border border-slate-700">
					View Features
				</a>
			</div>
		</section>

		<section id="features" class="max-w-6xl mx-auto px-4 py-16 border-t border-slate-800">
			<div class="text-center max-w-2xl mx-auto mb-16">
				<h2 class="text-3xl font-bold tracking-tight text-slate-100 sm:text-4xl">
					Everything your business needs to win online
				</h2>
				<p class="mt-4 text-slate-400">
					We build clean, ultra-fast interfaces designed to turn local search traffic into real, paying customers.
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				<div class="bg-slate-800/50 border border-slate-800 p-8 rounded-xl hover:border-slate-700 transition-colors duration-200">
					<div class="w-10 h-10 bg-teal-500/10 rounded-lg flex items-center justify-center text-teal-400 mb-6">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" /></svg>
					</div>
					<h3 class="text-xl font-semibold text-slate-100">Blazing Fast Speed</h3>
					<p class="mt-3 text-slate-400 text-sm leading-relaxed">Built on modern architecture that loads instantly on any mobile device. Higher speeds mean better rankings.</p>
				</div>
				<div class="bg-slate-800/50 border border-slate-800 p-8 rounded-xl hover:border-slate-700 transition-colors duration-200">
					<div class="w-10 h-10 bg-emerald-500/10 rounded-lg flex items-center justify-center text-emerald-400 mb-6">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" /></svg>
					</div>
					<h3 class="text-xl font-semibold text-slate-100">Mobile-First UI</h3>
					<p class="mt-3 text-slate-400 text-sm leading-relaxed">Most local customers check your site from their phones. Our layouts look flawless on screens of all sizes.</p>
				</div>
				<div class="bg-slate-800/50 border border-slate-800 p-8 rounded-xl hover:border-slate-700 transition-colors duration-200">
					<div class="w-10 h-10 bg-blue-500/10 rounded-lg flex items-center justify-center text-blue-400 mb-6">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" /></svg>
					</div>
					<h3 class="text-xl font-semibold text-slate-100">Transparent Pricing</h3>
					<p class="mt-3 text-slate-400 text-sm leading-relaxed">No locked contracts or hidden fees. Just premium code built with integrity for independent brands.</p>
				</div>
			</div>
		</section>

		<section id="pricing" class="max-w-6xl mx-auto px-4 py-16 border-t border-slate-800">
			<div class="text-center max-w-2xl mx-auto mb-16">
				<h2 class="text-3xl font-bold tracking-tight text-slate-100 sm:text-4xl">Simple, honest pricing</h2>
				<p class="mt-4 text-slate-400">Pick the plan that fits your current phase of business.</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				<div class="bg-slate-800/30 border border-slate-800 p-8 rounded-xl">
					<h3 class="text-xl font-semibold text-slate-100">Starter</h3>
					<p class="mt-2 text-slate-400 text-sm">Perfect for new businesses.</p>
					<div class="mt-6 text-4xl font-bold text-white">$499</div>
					<ul class="mt-8 space-y-4 text-sm text-slate-300">
						<li class="flex items-center gap-3"><svg class="w-5 h-5 text-teal-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Single Page Layout</li>
						<li class="flex items-center gap-3"><svg class="w-5 h-5 text-teal-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Contact Form Integration</li>
						<li class="flex items-center gap-3"><svg class="w-5 h-5 text-teal-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Mobile Responsive</li>
					</ul>
					<a href="#contact" class="mt-8 block w-full py-3 px-4 bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded-lg text-center font-medium transition-colors">Choose Starter</a>
				</div>

				<div class="bg-slate-800 border-2 border-teal-500 p-8 rounded-xl relative transform md:-translate-y-4 shadow-xl shadow-teal-500/10">
					<div class="absolute top-0 left-1/2 transform -translate-x-1/2 -translate-y-1/2 bg-teal-500 text-slate-900 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wide">Most Popular</div>
					<h3 class="text-xl font-semibold text-slate-100">Professional</h3>
					<p class="mt-2 text-slate-400 text-sm">Everything an established shop needs.</p>
					<div class="mt-6 text-4xl font-bold text-white">$999</div>
					<ul class="mt-8 space-y-4 text-sm text-slate-300">
						<li class="flex items-center gap-3"><svg class="w-5 h-5 text-teal-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Up to 5 Pages</li>
						<li class="flex items-center gap-3"><svg class="w-5 h-5 text-teal-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> SEO Optimization</li>
						<li class="flex items-center gap-3"><svg class="w-5 h-5 text-teal-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Advanced Analytics</li>
					</ul>
					<a href="#contact" class="mt-8 block w-full py-3 px-4 bg-teal-500 hover:bg-teal-400 text-slate-900 rounded-lg text-center font-medium transition-colors">Choose Pro</a>
				</div>

				<div class="bg-slate-800/30 border border-slate-800 p-8 rounded-xl">
					<h3 class="text-xl font-semibold text-slate-100">E-Commerce</h3>
					<p class="mt-2 text-slate-400 text-sm">For selling products directly online.</p>
					<div class="mt-6 text-4xl font-bold text-white">Custom</div>
					<ul class="mt-8 space-y-4 text-sm text-slate-300">
						<li class="flex items-center gap-3"><svg class="w-5 h-5 text-teal-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Full Store Setup</li>
						<li class="flex items-center gap-3"><svg class="w-5 h-5 text-teal-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Payment Gateway</li>
						<li class="flex items-center gap-3"><svg class="w-5 h-5 text-teal-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Inventory Management</li>
					</ul>
					<a href="#contact" class="mt-8 block w-full py-3 px-4 bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded-lg text-center font-medium transition-colors">Let's Talk</a>
				</div>
			</div>
		</section>

		<section id="contact" class="max-w-4xl mx-auto px-4 py-16 mb-20 border-t border-slate-800">
			<div class="text-center mb-12">
				<h2 class="text-3xl font-bold tracking-tight text-slate-100">Let's build something great.</h2>
				<p class="mt-4 text-slate-400">Fill out the form below and we'll get back to you within 24 hours.</p>
			</div>
			
			<form class="bg-slate-800/50 border border-slate-800 p-8 rounded-xl shadow-lg">
				<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
					<div>
						<label class="block text-sm font-medium text-slate-300 mb-2">Your Name</label>
						<input type="text" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-3 text-slate-100 focus:outline-none focus:border-teal-500 focus:ring-1 focus:ring-teal-500 transition-colors" placeholder="Jane Doe">
					</div>
					<div>
						<label class="block text-sm font-medium text-slate-300 mb-2">Email Address</label>
						<input type="email" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-3 text-slate-100 focus:outline-none focus:border-teal-500 focus:ring-1 focus:ring-teal-500 transition-colors" placeholder="jane@example.com">
					</div>
				</div>
				<div class="mb-6">
					<label class="block text-sm font-medium text-slate-300 mb-2">Business Name</label>
					<input type="text" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-3 text-slate-100 focus:outline-none focus:border-teal-500 focus:ring-1 focus:ring-teal-500 transition-colors" placeholder="Main Street Bakery">
				</div>
				<div class="mb-8">
					<label class="block text-sm font-medium text-slate-300 mb-2">Project Details</label>
					<textarea rows="4" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-3 text-slate-100 focus:outline-none focus:border-teal-500 focus:ring-1 focus:ring-teal-500 transition-colors" placeholder="Tell us a little about what you need..."></textarea>
				</div>
				<button type="submit" class="w-full bg-teal-500 hover:bg-teal-400 text-slate-900 font-bold py-4 px-6 rounded-lg transition-colors duration-200">
					Send Message
				</button>
			</form>
		</section>

	</main>
</Layout>