---
let SignIn = null;
if (process.env.CLERK_PUBLISHABLE_KEY) {
  const mod = await import('@clerk/astro/components');
  SignIn = mod.SignIn;
}
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Agency OS | Secure Login</title>
</head>
<body class="bg-[#0a0a0a] flex items-center justify-center h-screen w-screen px-4">
  
  <div class="relative">
    <div class="absolute inset-0 bg-indigo-500/20 blur-[80px] rounded-full pointer-events-none"></div>
    {SignIn ? <SignIn forceRedirectUrl="/admin" /> : <p class="text-slate-400">Sign-in is disabled (CLERK_PUBLISHABLE_KEY not set)</p>}
  </div>

  <script src="https://cdn.tailwindcss.com"></script>
</body>
</html>
