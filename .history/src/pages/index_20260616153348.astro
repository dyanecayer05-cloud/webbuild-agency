---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Affordable Web Design for Small Businesses";
---

<Layout title={pageTitle}>
	<main class="min-h-screen bg-slate-900 text-slate-100 font-sans">
		
		<section class="max-w-6xl mx-auto px-4 py-20 md:py-32 flex flex-col items-center text-center">
			<span class="text-sm font-semibold tracking-wider text-teal-400 uppercase bg-teal-400/10 px-3 py-1 rounded-full mb-6">
				Now Serving Our Community
			</span>
			<h1 class="text-4xl md:text-6xl font-bold tracking-tight max-w-3xl leading-tight text-slate-500">
				Premium digital presence, built to lift up <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-400 to-emerald-400">local businesses</span>.
			</h1>
			<p class="mt-6 text-lg md:text-xl text-slate-400 max-w-2xl">
				No corporate overhead. No massive agency price tags. Just clean, high-performance web engineering to help your shop, trade, or boutique thrive.
			</p>
			<div class="mt-10 flex flex-wrap justify-center gap-4">
				<a href="#contact" class="px-6 py-3 bg-teal-500 hover:bg-teal-400 text-slate-950 font-medium rounded-lg transition-colors duration-200">
					Get Started
				</a>
				<a href="#features" class="px-6 py-3 bg-slate-800 hover:bg-slate-700 text-slate-200 font-medium rounded-lg transition-colors duration-200 border border-slate-700">
					View Features
				</a>
			</div>
		</section>

		<section id="features" class="max-w-6xl mx-auto px-4 py-16 border-t border-slate-800">
			<div class="text-center max-w-2xl mx-auto mb-16">
				<h2 class="text-3xl font-bold tracking-tight text-slate-100 sm:text-4xl">
					Everything your business needs to win online
				</h2>
				<p class="mt-4 text-slate-400">
					We build clean, ultra-fast interfaces designed to turn local search traffic into real, paying customers.
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				<div class="bg-slate-800/50 border border-slate-800 p-8 rounded-xl hover:border-slate-700 transition-colors duration-200">
					<div class="w-10 h-10 bg-teal-500/10 rounded-lg flex items-center justify-center text-teal-400 mb-6">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
							<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
						</svg>
					</div>
					<h3 class="text-xl font-semibold text-slate-100">Blazing Fast Speed</h3>
					<p class="mt-3 text-slate-400 text-sm leading-relaxed">
						Built on modern architecture that loads instantly on any mobile device. Higher speeds mean better rankings on Google search results.
					</p>
				</div>

				<div class="bg-slate-800/50 border border-slate-800 p-8 rounded-xl hover:border-slate-700 transition-colors duration-200">
					<div class="w-10 h-10 bg-emerald-500/10 rounded-lg flex items-center justify-center text-emerald-400 mb-6">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
							<path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" />
						</svg>
					</div>
					<h3 class="text-xl font-semibold text-slate-100">Mobile-First UI</h3>
					<p class="mt-3 text-slate-400 text-sm leading-relaxed">
						Most local customers check your site from their phones. Our layouts look flawless and clear on screens of all sizes.
					</p>
				</div>

				<div class="bg-slate-800/50 border border-slate-800 p-8 rounded-xl hover:border-slate-700 transition-colors duration-200">
					<div class="w-10 h-10 bg-blue-500/10 rounded-lg flex items-center justify-center text-blue-400 mb-6">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
							<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" />
						</svg>
					</div>
					<h3 class="text-xl font-semibold text-slate-100">Transparent Pricing</h3>
					<p class="mt-3 text-slate-400 text-sm leading-relaxed">
						Built specifically for startups, trades, and independent brands. No locked contracts or hidden fees—just premium code built with integrity.
					</p>
				</div>
			</div>
		</section>

	</main>
</Layout>
