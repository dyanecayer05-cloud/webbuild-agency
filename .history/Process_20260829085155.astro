---
// src/components/Process.astro
const steps = [
  {
    step: "01",
    title: "Submit the Brief",
    desc: "Fill out the intake form with your business goals, target audience, and preferred style. No 60-minute sales pitches required."
  },
  {
    step: "02",
    title: "Bespoke Engineering Sprint",
    desc: "We build your high-speed static architecture, configure local SEO metadata, and optimize every asset for 100/100 Core Web Vitals."
  },
  {
    step: "03",
    title: "Live Production Cutover",
    desc: "We connect your custom domain, provision automated SSL encryption, and hand over a turnkey, high-converting asset."
  }
];
---

<section id="process" class="w-full max-w-7xl mx-auto px-6 md:px-12 py-24 scroll-mt-24 border-t border-slate-800/40">
  <div class="max-w-3xl mb-16">
    <div class="text-xs uppercase tracking-widest text-indigo-400 font-bold mb-3">How It Works</div>
    <h2 class="text-3xl md:text-5xl font-extrabold tracking-tight text-white mb-6">
      From intake to live deployment in days.
    </h2>
    <p class="text-lg text-slate-400 leading-relaxed">
      A streamlined, transparent development pipeline built to eliminate back-and-forth delays.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    {steps.map((item) => (
      <div class="bg-slate-900/40 border border-slate-800/80 rounded-2xl p-8 relative hover:border-indigo-500/40 transition">
        <span class="text-4xl font-black text-indigo-500/30 mb-4 block font-mono">{item.step}</span>
        <h3 class="text-xl font-bold text-white mb-3">{item.title}</h3>
        <p class="text-slate-400 leading-relaxed text-sm md:text-base">{item.desc}</p>
      </div>
    ))}
  </div>
</section>